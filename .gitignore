/llm_gateway/run/
# Every harness workspace can produce local sessions, plugins and auth files.
# Commit only the reviewed prompt and documentation templates.
/workspaces/*/*
!/workspaces/*/agent.md
!/workspaces/*/README.md

# Local snapshots and packages
*.bak
*.bak_*
*.draft_patched_*
*.tgz
*.zip
/eval_harness/--
