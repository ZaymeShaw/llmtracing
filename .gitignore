# Local configuration and credentials
**/.env
**/.env.*
!**/.env.example
**/.mcp.json
**/.claude/
.codex/

# Local runtimes and generated output
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/.DS_Store
**/node_modules/
**/*.pyc
/backups/
/eval_runs/
/eval_harness/data/
/eval_harness/bundles/
/var/
