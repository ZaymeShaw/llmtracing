#!/usr/bin/env python3
"""llmtrace <object> <action> — single entry point for local llmtracing ops.

    llmtrace gateway list|show|check|up|down|restart ...   (llm_gateway/gatewayctl.py)
    llmtrace gateway rotate NAME.. [--keep N]                gzip the call log aside (refused while a lane is leased)
    llmtrace query calls --execution-id ID|--case-id ID|--run-id ID|--since T [--until T] [--gateway NAME|--log PATH]
                         [--format table|json|detail|jsonl|pairs] [--settle SECS] [--cursor FILE] [--events]
                         [--include-rotated] [--full] [--html OUT_DIR]
    llmtrace query show CALL_ID [--full]                    one call: messages, tool calls, usage, error
    llmtrace query cursor [--gateway NAME|--log PATH]       end-of-log cursor for a later `calls --cursor`
    llmtrace lane recover NAME --execution-id ID            clear a blocked lane after its work stopped
    llmtrace report html RUN_DIR [--zip]
    llmtrace report html --gateway NAME|--log PATH --out DIR [--executions ..] [--cases ..] [--run-id ..]
"""
from __future__ import annotations

import importlib.util
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ.get("MOCK_SYSTEM_ROOT") or Path(__file__).resolve().parent).resolve()
GATEWAY_DIR = ROOT / "llm_gateway"
HARNESS_SRC = ROOT / "eval_harness" / "src"


def _gatewayctl():
    spec = importlib.util.spec_from_file_location("gatewayctl", GATEWAY_DIR / "gatewayctl.py")
    module = importlib.util.module_from_spec(spec)
    sys.modules["gatewayctl"] = module
    spec.loader.exec_module(module)
    return module


def _harness(module: str, args: list[str]) -> int:
    env = dict(os.environ)
    env["PYTHONPATH"] = str(HARNESS_SRC) + (os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
    return subprocess.call([sys.executable, "-m", module, *args], env=env)


def _take(argv: list[str], flag: str) -> str | None:
    if flag in argv:
        i = argv.index(flag)
        if i + 1 >= len(argv):
            raise SystemExit(f"{flag} needs a value")
        value = argv[i + 1]
        del argv[i:i + 2]
        return value
    return None


def report(argv: list[str]) -> int:
    if not argv or argv[0] != "html":
        raise SystemExit("usage: llmtrace report html ...")
    argv = argv[1:]
    gateway = _take(argv, "--gateway")
    log = _take(argv, "--log")
    out = _take(argv, "--out")
    if gateway and log:
        raise SystemExit("pass --gateway or --log, not both")
    if gateway:
        log = str(_gatewayctl().load(gateway, GATEWAY_DIR).log_file)
    if log:
        if not out:
            raise SystemExit("--out DIR required with --gateway/--log")
        argv = ["--from-gateway-log", log, "--out-run-dir", out, *argv]
    return _harness("eval_harness.llm_trace_html", argv)


def lane(argv: list[str]) -> int:
    if len(argv) < 2 or argv[0] != "recover":
        raise SystemExit("usage: llmtrace lane recover NAME --execution-id ID")
    return _harness("eval_harness.attribution_lane", ["--gateway", argv[1], *argv[2:]])


def query(argv: list[str]) -> int:
    if not argv or argv[0] not in ("calls", "show", "cursor"):
        raise SystemExit("usage: llmtrace query calls --execution-id ID ... | show CALL_ID | cursor --gateway NAME")
    return _harness("eval_harness.query", argv)


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    obj, rest = argv[0], argv[1:]
    if obj == "gateway":
        return _gatewayctl().main(rest, prog="llmtrace gateway")
    if obj == "lane":
        return lane(rest)
    if obj == "query":
        return query(rest)
    if obj == "report":
        return report(rest)
    print(f"unknown object {obj!r}\n\n{__doc__.strip()}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
