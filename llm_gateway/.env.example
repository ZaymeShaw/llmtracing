# Copy to .env (default) OR to .env.<profile> for an extra switchable upstream.
# After edits: ./stop_litellm.sh && ./start_litellm.sh [--profile NAME]

UPSTREAM_API_BASE=https://dashscope.aliyuncs.com/apps/anthropic
UPSTREAM_API_KEY=replace-with-upstream-api-key
UPSTREAM_PROTOCOL=anthropic
UPSTREAM_MODEL=deepseek-v4-flash-0731

LITELLM_HOST=127.0.0.1
LITELLM_PORT=4001
LITELLM_MASTER_KEY=replace-with-local-master-key
LITELLM_CONFIG=./config.litellm.with_master.yaml

# Gateway writes <this directory>/llm_calls.jsonl; use that file when exporting tracing.
# start_litellm.sh runs from llm_gateway/, so ./logs means llm_gateway/logs/.
LLM_GATEWAY_LOG_DIR=./logs

# Optional: update an existing Claude workspace settings file on relay startup.
# Relay-only, Pi and HTTP clients do not need this.
LITELLM_SYNC_CLAUDE_SETTINGS=0
